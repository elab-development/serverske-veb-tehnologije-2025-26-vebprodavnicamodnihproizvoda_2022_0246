                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Saska Savic"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "saska@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Korisnik uspešno registrovan"
                    },
                    "422": {
                        "description": "Greška validacije"
                    }
                }
            }
        },
